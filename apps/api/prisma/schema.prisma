generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  Id           String     @id @default(cuid())
  Name         String
  Email        String     @unique
  PasswordHash String
  Nim          String
  CreatedAt    DateTime   @default(now())
  Schedules    Schedule[]
  Tasks        Task[]
  Notes        Note[]
}

model Schedule {
  Id         String   @id @default(cuid())
  UserId     String
  CourseName String
  Lecturer   String
  Day        String
  StartTime  String
  EndTime    String
  Room       String
  CreatedAt  DateTime @default(now())
  User       User     @relation(fields: [UserId], references: [Id], onDelete: Cascade)

  @@index([UserId, Day])
}

model Task {
  Id          String     @id @default(cuid())
  UserId      String
  Title       String
  Description String     @db.Text
  Deadline    DateTime
  Status      TaskStatus @default(TODO)
  CreatedAt   DateTime   @default(now())
  UpdatedAt   DateTime   @updatedAt
  User        User       @relation(fields: [UserId], references: [Id], onDelete: Cascade)
  Notes       Note[]

  @@index([UserId, Status, Deadline])
}

model Note {
  Id            String    @id @default(cuid())
  UserId        String
  Title         String
  Content       String    @db.Text
  RelatedTaskId String?
  CreatedAt     DateTime  @default(now())
  UpdatedAt     DateTime  @updatedAt
  User          User      @relation(fields: [UserId], references: [Id], onDelete: Cascade)
  RelatedTask   Task?     @relation(fields: [RelatedTaskId], references: [Id], onDelete: SetNull)

  @@index([UserId, UpdatedAt])
}

model Course {
  Id        String    @id @default(cuid())
  Name      String
  Semester  String
  Year      Int
  CreatedAt DateTime  @default(now())
  Students  Student[]
}

model Student {
  Id             String       @id @default(cuid())
  CourseId       String
  StudentNumber  String
  Name           String
  Email          String
  GithubUsername String
  CreatedAt      DateTime     @default(now())
  Course         Course       @relation(fields: [CourseId], references: [Id], onDelete: Cascade)
  Repositories   Repository[]

  @@unique([CourseId, StudentNumber])
  @@index([CourseId, Name])
}

model Repository {
  Id             String   @id @default(cuid())
  StudentId      String
  Name           String
  RepositoryUrl  String   @db.VarChar(2048)
  Owner          String
  RepositoryName String
  IsActive       Boolean  @default(true)
  LastSyncedAt   DateTime?
  CreatedAt      DateTime @default(now())
  Student        Student  @relation(fields: [StudentId], references: [Id], onDelete: Cascade)
  Commits        Commit[]

  @@index([StudentId, IsActive])
}

model Commit {
  Id          String     @id @default(cuid())
  RepositoryId String
  Sha         String     @db.VarChar(64)
  Message     String     @db.Text
  AuthorName  String
  AuthorEmail String
  CommittedAt DateTime
  CommitUrl   String     @db.VarChar(2048)
  CreatedAt   DateTime   @default(now())
  Repository  Repository @relation(fields: [RepositoryId], references: [Id], onDelete: Cascade)

  @@unique([RepositoryId, Sha])
  @@index([RepositoryId, CommittedAt])
}